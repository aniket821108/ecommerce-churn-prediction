############################
.env
.env.*
*.env
# Allow .env.example templates for project setup
!.env.example
!**/.env.example

############################
# 📦 Node Modules
############################
node_modules/
backend/node_modules/
frontend/node_modules/

############################
# 📝 Logs
############################
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

############################
# 🗂 Build Folders
############################
dist/
build/
frontend/dist/
backend/dist/

############################
# ⚛️ React / Vite
############################
.vite/
.cache/
.eslintcache

############################
# 🧠 ML / Python
############################
__pycache__/
*.pyc
*.pyo
*.pyd
*.joblib
*.pkl
*.h5
*.pt
*.onnx
*.model

# Allow ML model files needed for the app to work
!backend/ml-models/*.pkl
!backend/ml-models/features_list.json

venv/
env/
.venv/

############################
# 📊 Data & Datasets
############################
data/
datasets/
*.csv
*.xlsx
*.json

# Allow JSON config files needed by the app
!backend/ml-models/features_list.json
!**/package.json
!**/package-lock.json

############################
